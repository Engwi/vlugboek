PORT=8788
HOST=127.0.0.1
NODE_ENV=production
MAIL_JSON_LIMIT=50mb

# Shared secret used by Vlugboek API -> mailer.
MAIL_WEBHOOK_TOKEN=replace-with-a-long-random-token

# Gmail app sender.
MAIL_FROM_NAME=Vlugboek
MAIL_FROM_ADDRESS=replace-with-sender@example.com
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=replace-with-sender@example.com
SMTP_PASSWORD=replace-with-smtp-password
SMTP_CONNECTION_TIMEOUT=10000
SMTP_GREETING_TIMEOUT=10000
SMTP_SOCKET_TIMEOUT=20000

# Legacy Gmail aliases are still supported:
# GMAIL_USER=replace-with-sender@gmail.com
# GMAIL_APP_PASSWORD=replace-with-gmail-app-password

# Optional safety for test phase.
# ALLOWED_TO_DOMAIN=example.com
